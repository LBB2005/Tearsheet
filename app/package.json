{
  "name": "tearsheet",
  "productName": "Tearsheet",
  "version": "0.1.0-beta",
  "private": true,
  "description": "A Mac app for cited research reports on S&P 500 companies, written by your own AI tool.",
  "license": "MIT",
  "author": "Liam Blackshaw-Brown",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "package": "TEARSHEET_TEST_BUILD=0 npm run bundle",
    "package:test": "TEARSHEET_TEST_BUILD=1 npm run bundle -- -c.electronFuses.enableNodeCliInspectArguments=true",
    "bundle": "../scripts/build-engine.sh && electron-vite build && electron-builder",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "gen-types": "../scripts/gen-types.sh"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "2.1.9",
    "electron": "^33.2.1",
    "electron-builder": "26.18.0",
    "electron-vite": "^2.3.0",
    "jsdom": "^25.0.1",
    "json-schema-to-typescript": "^15.0.3",
    "postcss": "^8.5.32",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "2.1.9"
  }
}
