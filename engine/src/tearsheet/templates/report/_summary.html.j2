{#- The Summary view, shown first: a line written by code with the call and its numbers, the red
    flag, the first surviving claim of each section, then the triggers and checks. Built only from
    claims that passed the checks. Imported with context: it uses `r`, `n`, `fmt` and
    `red_flag_labels`. -#}
{%- from "report/_full.html.j2" import claim with context -%}

{%- macro ordinal(k) -%}
{{ k }}{% if k % 100 in [11, 12, 13] %}th{% elif k % 10 == 1 %}st{% elif k % 10 == 2 %}nd{% elif k % 10 == 3 %}rd{% else %}th{% endif %}
{%- endmacro -%}

{%- macro range_text() -%}
the 12-month range runs from {{ fmt("price", n.range.bear) }} to {{ fmt("price", n.range.bull) }}
{%- endmacro -%}

{%- macro summary_view() -%}
{%- set ns = namespace(flags=[], first_rating="", kept=0) -%}
{%- for s in r.sections -%}
{%- set ns.kept = ns.kept + (s.sentences or [])|length -%}
{%- if s.key == "rating" and s.paragraphs -%}{%- set ns.first_rating = s.paragraphs[0] -%}{%- endif -%}
{%- if s.key == "risks" -%}
{%- for p in s.paragraphs or [] if p is string and p.startswith("Red flag:") -%}{%- set ns.flags = ns.flags + [p] -%}{%- endfor -%}
{%- endif -%}
{%- endfor -%}
<section id="summary" class="view" aria-label="Summary">
<article class="txt glass">
<h3>Summary</h3>
<p class="callline">
{%- if n.rating -%}
<b class="{{ n.rating.call|lower }}">{{ n.rating.call }}</b>{% if n.rating.capped %}, capped by a red flag{% endif %}.
{%- if n.score %} {{ r.ticker }} scores in the {{ ordinal(n.score.percentile) }} percentile of its peer group.{% endif %}
{%- if n.price %} The price is {{ fmt("price", n.price.value) }}{% if n.estimate %} against an estimated value of {{ fmt("price", n.estimate.value) }}{% endif %}{% if n.range %}, and {{ range_text() }}{% endif %}.
{%- elif n.estimate %} The estimated value is {{ fmt("price", n.estimate.value) }}{% if n.range %}, and {{ range_text() }}{% endif %}.
{%- elif n.range %} The 12-month range runs from {{ fmt("price", n.range.bear) }} to {{ fmt("price", n.range.bull) }}.
{%- endif %}
{%- elif ns.first_rating -%}
{{ ns.first_rating }}
{%- else -%}
The rating is not stored for this report.
{%- endif -%}
</p>
{%- for p in ns.flags %}
<div class="rf"><b>Red flag:</b>{{ p[9:] }}</div>
{%- else %}
{%- if n.red_flags %}
<div class="rf"><b>Red flag:</b> {% for code in n.red_flags %}{{ red_flag_labels.get(code) or code|replace("_", " ")|capitalize }}{% if not loop.last %}, {% endif %}{% endfor %}. Any red flag caps the rating at Hold.</div>
{%- endif %}
{%- endfor %}
<h4 class="sh">The first point in each section</h4>
<ol class="kp">
{%- for s in r.sections if s.sentences %}
<li><span class="sec">{% if s.number %}{{ s.number }}. {% endif %}{{ s.title }}</span>{{ claim(s, s.sentences[0], read=true) }}</li>
{%- else %}
<li class="none">No claim passed the checks in this report.</li>
{%- endfor %}
</ol>
<h4 class="sh">Triggers and checks</h4>
<p class="code">
{%- if n.triggers -%}
Buy trigger: <b>{{ fmt("price", n.triggers.buy) if n.triggers.buy is number else n.triggers.buy_text }}</b>. Sell trigger: <b>{{ fmt("price", n.triggers.sell) if n.triggers.sell is number else n.triggers.sell_text }}</b>.
{%- else -%}
Triggers not stored for this report.
{%- endif %}
{%- set checks = r.checks or [] %}
{%- if checks %} <b>{{ ns.kept }} {{ "claim" if ns.kept == 1 else "claims" }}</b> passed the {% if checks|length > 1 %}{{ checks[:-1]|join(", the ") }} and the {{ checks[-1] }}{% else %}{{ checks[0] }}{% endif %}; <b>{{ (r.removed or [])|length }}</b> {{ "was" if (r.removed or [])|length == 1 else "were" }} removed.{% endif -%}
</p>
</article>
</section>
{%- endmacro -%}
