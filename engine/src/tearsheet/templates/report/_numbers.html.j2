{#- The numbers column, in the spec's order. Every panel is drawn from `n` (the numbers dict);
    a piece that is None says "not stored for this report". Imported with context: it uses `r`,
    `n`, `fmt`, `metric_text`, `red_flag_labels` and `ro`, and `hot` uses `mode` and `open_link`.
    Each chart, bar, ring, tile and figure is hot: it shows its readout from readouts.py when
    pointed at or focused, and in the app opens its bigger view. -#}
{%- from "report/_svg.html.j2" import gauge, donut, price_path, methods_chart with context -%}
{%- from "report/_hot.html.j2" import hot with context -%}

{%- set MONTHS = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"] -%}

{%- macro gap(what="") -%}<p class="gap">{% if what %}{{ what }} not stored for this report.{% else %}Not stored for this report.{% endif %}</p>{%- endmacro -%}

{#- "2025-11-14" → "Nov 2025", with `years` added. Anything else gives nothing. -#}
{%- macro month_of_iso(day, years=0) -%}
{%- set parts = (day|string).split("-") -%}
{%- if parts|length == 3 and parts[0].isdigit() and parts[1].isdigit() and 1 <= parts[1]|int <= 12 -%}{{ MONTHS[parts[1]|int - 1] }} {{ parts[0]|int + years }}{%- endif -%}
{%- endmacro -%}

{#- "4 Nov 2026" → "4 Nov"; anything else is shown as it is. -#}
{%- macro day_month(day) -%}
{%- set parts = (day|string).split(" ") -%}
{{ parts[0] ~ " " ~ parts[1] if parts|length == 3 and parts[2].isdigit() else day }}
{%- endmacro -%}

{%- macro flag_names(codes) -%}
{%- for code in codes -%}{{ (red_flag_labels.get(code) or code|replace("_", " "))|lower }}{% if not loop.last %}, {% endif %}{%- endfor -%}
{%- endmacro -%}

{%- macro signed(v) -%}{{ ("%+.1f"|format(v)).replace("-", "−") }}%{%- endmacro -%}

{#- Whole dollars, for a tile: 130.16 → "$130". -#}
{%- macro dollars(v) -%}{{ "${:,.0f}".format(v) }}{%- endmacro -%}

{%- macro not_stored() -%}<b class="miss">not stored</b>{%- endmacro -%}

{#- A tile that is hot when it has a readout, and plain when there is nothing stored to read. -#}
{%- macro hot_if(view, item, text) -%}
{%- set body = caller() -%}
{%- if text %}{% call hot(view, item, text) %}{{ body }}{% endcall %}{% else %}{{ body }}{% endif -%}
{%- endmacro -%}

{#- A narrow window's five key-number tiles, above the text (the spec's "Narrow windows"): the
    rating and score, price, estimated value, the 12-month range and the past year. -#}
{%- macro key_strip() -%}
{%- set today = n.price.value if n.price else (n.weekly[-1].close if n.weekly else none) -%}
<div id="keys" class="keys" role="group" aria-label="Key numbers">
{%- set score_pct = n.score.percentile if n.score else none %}
{%- call hot_if("factors", none, ro.rating(n.rating.call, n.rating.capped, score_pct) if n.rating else (ro.score(score_pct) if n.score else "")) -%}
<div class="kt"><span>Rating and score</span>
{%- if n.rating or n.score -%}
{% if n.rating %}<b class="{{ n.rating.call|lower }}">{{ n.rating.call }}</b>{% endif %}{% if n.score %} <b>{{ n.score.percentile }}</b>{% endif %}
{%- else %}{{ not_stored() }}{% endif -%}
</div>
{%- endcall %}
{%- call hot_if("price", none, ro.price(n.price.value, n.price.date) if n.price else "") -%}
<div class="kt"><span>Price{% if n.price %}, {{ day_month(n.price.date) }}{% endif %}</span>{% if n.price %}<b>{{ fmt("price", n.price.value) }}</b>{% else %}{{ not_stored() }}{% endif %}</div>
{%- endcall %}
{%- call hot_if("methods", none, ro.estimate(n.estimate.value, today) if n.estimate else "") -%}
<div class="kt"><span>Estimated value</span>{% if n.estimate %}<b>{{ fmt("price", n.estimate.value) }}</b>{% else %}{{ not_stored() }}{% endif %}</div>
{%- endcall %}
{%- call hot_if("price", none, ro.band(n.range.bear, n.range.bull) if n.range else "") -%}
<div class="kt"><span>12-month range</span>
{%- if n.range -%}
{%- set lo0 = [n.range.bear, today if today is number else n.range.bear]|min -%}
{%- set hi0 = [n.range.bull, today if today is number else n.range.bull]|max -%}
{%- set pad = (hi0 - lo0) * 0.12 -%}
{%- set lo, span = lo0 - pad, [hi0 - lo0 + 2 * pad, 0.01]|max -%}
{%- macro at(v) -%}{{ "%.1f"|format([[(v - lo) / span * 100, 0]|max, 100]|min) }}%{%- endmacro -%}
<b>{{ dollars(n.range.bear) }} to {{ dollars(n.range.bull) }}</b>
<div class="mini" aria-hidden="true"><i class="b" style="left:{{ at(n.range.bear) }};width:{{ "%.1f"|format((n.range.bull - n.range.bear) / span * 100) }}%"></i>{% if n.range.base is number %}<i class="m" style="left:{{ at(n.range.base) }}"></i>{% endif %}{% if today is number %}<i class="pm" style="left:{{ at(today) }}"></i>{% endif %}</div>
{%- else %}{{ not_stored() }}{% endif -%}
</div>
{%- endcall %}
{%- set year = n.returns_12m and n.returns_12m.company is number %}
{%- call hot_if("returns", none, ro.total_return(r.ticker, n.returns_12m.company, 1) if year else "") -%}
<div class="kt"><span>Past year</span>{% if year %}<b class="{{ 'down' if n.returns_12m.company < 0 else 'up' }}">{{ signed(n.returns_12m.company) }}</b>{% else %}{{ not_stored() }}{% endif %}</div>
{%- endcall %}
</div>
{%- endmacro -%}

{%- macro numbers_column() -%}
{%- set today = n.price.value if n.price else (n.weekly[-1].close if n.weekly else none) -%}
<aside id="numbers" class="nums" aria-label="Numbers">

{#- 1. The rating, with the score ring, the red-flag note, price, estimated value, buy trigger
       and value gap percentile. #}
<section class="p glass span2">
<div class="tkr">{{ r.ticker }}<small>{{ r.company }}, report run {{ r.run_at }}</small></div>
{%- if n.rating or n.score %}
<div class="callrow">
{%- if n.score %}
{#- The ring is the panel's first row under the ticker, so its readout shows below it, over the
    tiles. #}
{% call hot("factors", none, ro.score(n.score.percentile), below=true) %}<div class="ring">{{ gauge(84, 7, n.score.percentile / 100) }}<div><b>{{ n.score.percentile }}</b><span>score</span></div></div>{% endcall %}
{%- endif %}
<div>{% if n.rating %}<div class="call {{ n.rating.call|lower }}">{{ n.rating.call }}</div><span>next 12 months, against its peers</span>{% else %}{{ gap("The rating is") }}{% endif %}</div>
</div>
{%- else %}
{{ gap("The rating and score are") }}
{%- endif %}
{%- if n.rating and n.rating.capped %}
<div class="note">Capped by a red flag{% if n.red_flags %}: {{ flag_names(n.red_flags) }}{% endif %}.</div>
{%- elif n.red_flags %}
<div class="note">Red flag: {{ flag_names(n.red_flags) }}. Any red flag caps the rating at Hold.</div>
{%- endif %}
{#- Each tile is its own one-term list, so a hot tile's link can hold it. #}
<div class="kvs">
{%- call hot_if("price", none, ro.price(n.price.value, n.price.date) if n.price else "") -%}
<dl><dt>Price{% if n.price %}, {{ day_month(n.price.date) }}{% endif %}</dt>{% if n.price %}<dd>{{ fmt("price", n.price.value) }}</dd>{% else %}<dd class="miss">not stored</dd>{% endif %}</dl>
{%- endcall %}
{%- call hot_if("methods", none, ro.estimate(n.estimate.value, today) if n.estimate else "") -%}
<dl><dt>Estimated value</dt>{% if n.estimate %}<dd>{{ fmt("price", n.estimate.value) }}</dd>{% else %}<dd class="miss">not stored</dd>{% endif %}</dl>
{%- endcall %}
{%- if n.triggers %}
{%- set buy = n.triggers.buy if n.triggers.buy is number else none %}
{%- call hot_if("price", none, ro.trigger(buy, fmt("price", buy) if buy is not none else n.triggers.buy_text) if buy is not none or n.triggers.buy_text else "") -%}
<dl><dt>Buy trigger</dt>{% if buy is not none %}<dd>{{ fmt("price", buy) }}</dd>{% else %}<dd class="words">{{ n.triggers.buy_text }}</dd>{% endif %}</dl>
{%- endcall %}
{%- else %}
<dl><dt>Triggers</dt><dd class="miss">not stored</dd></dl>
{%- endif %}
{%- set gap_pct = n.estimate.gap_percentile if n.estimate and n.estimate.gap_percentile is number else none %}
{%- call hot_if("methods", none, ro.gap(gap_pct) if n.estimate else "") -%}
<dl><dt>Value gap percentile</dt>{% if gap_pct is not none %}<dd>{{ gap_pct }}</dd>{% elif n.estimate %}<dd class="miss">not available</dd>{% else %}<dd class="miss">not stored</dd>{% endif %}</dl>
{%- endcall %}
</div>
{#- The line sits with the rating as well as at the foot of the report (launch-readiness M5). #}
<p class="afoot advice">{{ ADVICE_SHORT }}</p>
</section>

{#- 2. The past year's weekly prices running into the 12-month range, drawn as a fan. #}
<section class="p glass span2">
<h4><span>Past year and the 12-month range</span>{% if n.rating and n.rating.uncertainty %}<em>uncertainty {{ n.rating.uncertainty }}</em>{% endif %}</h4>
{%- if n.weekly or n.range %}
{%- set start = month_of_iso(n.weekly[0].date) if n.weekly else "" %}
{%- set end = month_of_iso(n.weekly[-1].date, 1) if n.weekly else "" %}
{%- set middle = ("Today " ~ fmt("price", today)) if today is number else "Today" %}
{%- set label = "Weekly price over the past year" ~ ((", from " ~ fmt("price", n.weekly[0].close) ~ " to " ~ fmt("price", n.weekly[-1].close)) if n.weekly else "") ~ ((", then the 12-month range from " ~ fmt("price", n.range.bear) ~ " to " ~ fmt("price", n.range.bull)) if n.range else "") %}
{{ price_path(n.weekly, today, n.range, start, middle, end, label) }}
{%- else %}
{{ gap() }}
{%- endif %}
</section>

{#- 3. Factor percentiles with weights, with a line at the peer median. #}
<section class="p glass span2">
<h4><span>Score by factor</span><em>percentile and weight; line at the peer median</em></h4>
{%- for f in n.factors or [] %}
{%- set weight = ("%.1f"|format(f.weight * 100)).rstrip("0").rstrip(".") %}
{% call hot("factors", loop.index0, ro.factor(f.name, f.percentile, f.weight), "bar fbar") %}<span>{{ f.name|capitalize }}</span><div class="tr"><i style="width:{{ [[f.percentile, 0]|max, 100]|min }}%"></i><span class="mid"></span></div><b>{{ f.percentile }}</b><small>{{ weight }}%</small>{% endcall %}
{%- else %}
{{ gap() }}
{%- endfor %}
</section>

{#- 4. The key metrics against the peer median. #}
<section class="p glass span2">
<h4><span>Key metrics against the peer median</span><em>dot: share of peers below {{ r.ticker }}</em></h4>
{%- if n.metrics %}
{#- The first row's readouts show below it, where above would leave the panel. The row's length
    follows the panel's width; five tiles is the most that fit, at the column's widest, and in a
    narrower panel the second row's first tiles show theirs below too, over the row under them. #}
<div class="tiles">
{%- for m in n.metrics %}
{%- set median = metric_text(m.name, m.peer_median) if m.peer_median is number else none %}
{% call hot("metrics", m.name, ro.metric(m.label, metric_text(m.name, m.value), median, m.percentile if m.percentile is number else none, r.ticker), "tile", below=loop.index0 < 5) %}<span>{{ m.label }}</span><b>{{ metric_text(m.name, m.value) }}</b><small>{% if median is not none %}peers {{ median }}{% else %}no peer median{% endif %}</small><div class="rk">{% if m.percentile is number %}<i style="left:{{ [[m.percentile, 0]|max, 100]|min }}%"></i>{% endif %}</div>{% endcall %}
{%- endfor %}
</div>
{%- else %}
{{ gap() }}
{%- endif %}
</section>

{#- 5. Value per share by method. #}
<section class="p glass span2">
<h4><span>Value per share by method</span>{% if n.estimate %}<em>estimate {{ fmt("price", n.estimate.value) }}</em>{% endif %}</h4>
{%- if n.methods %}
{%- set label = "Value per share: " ~ (n.methods|map(attribute="method")|join(", ")) ~ (("; price " ~ fmt("price", today)) if today is number else "") %}
{{ methods_chart(n.methods, today, n.range, label, n.estimate.value if n.estimate else none) }}
{%- else %}
{{ gap() }}
{%- endif %}
</section>

{#- 6. The 12-month total return against the peers and the S&P 500. #}
<section class="p glass">
<h4><span>Total return, past 12 months</span></h4>
{%- if n.returns_12m %}
{%- set rows = [(r.ticker, n.returns_12m.company, "company"), ("Peer group", n.returns_12m.peers, "peers"), ("S&P 500", n.returns_12m.spy, "spy")] %}
{%- set lo0 = [0, n.returns_12m.company, n.returns_12m.peers, n.returns_12m.spy]|min %}
{%- set hi0 = [0, n.returns_12m.company, n.returns_12m.peers, n.returns_12m.spy]|max %}
{%- set pad = [(hi0 - lo0) * 0.1, 1]|max %}
{%- set lo, span = lo0 - pad, hi0 - lo0 + 2 * pad %}
{%- set zero = (0 - lo) / span * 100 %}
{%- for name, v, key in rows %}
{%- set at = (v - lo) / span * 100 %}
{% call hot("returns", key, ro.total_return(name, v, 1, group=key == "peers"), "bar rbar") %}<span>{{ name }}</span><div class="tr"><i class="{{ 'neg' if v < 0 else ('self' if key == 'company' else '') }}" style="left:{{ '%.1f'|format([zero, at]|min) }}%;width:{{ '%.1f'|format((at - zero)|abs) }}%"></i><span class="zero" style="left:{{ '%.1f'|format(zero) }}%"></span></div><b>{{ signed(v) }}</b>{% endcall %}
{%- endfor %}
{%- else %}
{{ gap() }}
{%- endif %}
</section>

{#- 7. The red-flag meter: the four checks, any one of which caps the rating at Hold. #}
<section class="p glass">
<h4><span>Red flags</span><em>any one caps the rating</em></h4>
{%- if n.red_flags is not none %}
{%- set others = n.red_flags|reject("in", red_flag_labels)|list %}
{%- set found, checks = n.red_flags|length, red_flag_labels|length + others|length %}
{% call hot("flags", none, ro.red_flags(found, checks)) %}<div class="flags" role="img" aria-label="{{ found }} of {{ checks }} red flags found">{% for code in red_flag_labels %}<i class="{{ 'on' if code in n.red_flags else '' }}"></i>{% endfor %}{% for code in others %}<i class="on"></i>{% endfor %}</div>{% endcall %}
{%- for code, label in red_flag_labels.items() %}
{% call hot("flags", code, ro.red_flag(label, code in n.red_flags), "kv") %}<span>{{ label }}</span>{% if code in n.red_flags %}<b class="found">found</b>{% else %}<b class="clear">clear</b>{% endif %}{% endcall %}
{%- endfor %}
{%- for code in others %}
{%- set label = code|replace("_", " ")|capitalize %}
{% call hot("flags", code, ro.red_flag(label, true), "kv") %}<span>{{ label }}</span><b class="found">found</b>{% endcall %}
{%- endfor %}
{%- else %}
{{ gap() }}
{%- endif %}
</section>

{#- 8. Five economic figures from FRED. #}
<section class="p glass span2">
<h4><span>Economy</span><em>FRED</em></h4>
{%- if n.economy %}
{#- The figures are the panel's one row, so their readouts show below them. #}
<div class="macro">
{%- for e in n.economy %}
{% call hot("economy", e.series, ro.economy(e.label, e.value, e.date), below=true) %}<div><b>{{ e.value }}</b><span>{{ e.label }}</span><small>{{ e.date }}</small></div>{% endcall %}
{%- endfor %}
</div>
{%- else %}
{{ gap() }}
{%- endif %}
</section>

{#- 9. Rings for the peer ratings, and for the claims kept and removed. #}
<section class="p glass span2">
<h4><span>Peer ratings and checks</span>{% if n.peer_ratings %}<em>peer ratings before red-flag caps</em>{% endif %}</h4>
<div class="donutrow">
{%- if n.peer_ratings %}
{%- set pr = n.peer_ratings %}
{%- set rated = pr.Buy + pr.Hold + pr.Sell %}
{%- set slices = [("buy", "Buy", pr.Buy), ("hold", "Hold", pr.Hold), ("sell", "Sell", pr.Sell)] %}
{#- The slices' readouts come before the ring, so each stays at the ring's top edge and shows
    just above it. #}
<div class="donut">
{%- for key, call, count in slices if count > 0 %}<span class="ro ro-{{ key }}" aria-hidden="true">{{ ro.peer_rating(call, count, rated) }}</span>{% endfor -%}
<div class="dn">{{ donut(80, 10, [[pr.Buy, "buy"], [pr.Hold, "hold"], [pr.Sell, "sell"]], "Peer ratings: " ~ pr.Buy ~ " Buy, " ~ pr.Hold ~ " Hold, " ~ pr.Sell ~ " Sell") }}<b>{{ rated }}</b></div>
</div>
<div class="legend">
{%- for key, call, count in slices %}{% call hot("rings", key, ro.peer_rating(call, count, rated)) %}<i class="{{ key }}"></i>{{ count }} {{ call }}{% endcall %}{% endfor -%}
</div>
{%- else %}
<div class="half">{{ gap("Peer ratings") }}</div>
{%- endif %}
{%- if n.claims %}
{%- set cl = n.claims %}
{%- set claimed = cl.kept + cl.removed %}
<div class="donut">
{%- for key, count in (("kept", cl.kept), ("removed", cl.removed)) if count > 0 %}<span class="ro ro-{{ key }}" aria-hidden="true">{{ ro.claims(key, count, claimed) }}</span>{% endfor -%}
<div class="dn">{{ donut(80, 10, [[cl.kept, "kept"], [cl.removed, "removed"]], cl.kept ~ " claims kept, " ~ cl.removed ~ " removed") }}<b>{{ claimed }}</b></div>
</div>
<div class="legend">{% call hot("rings", "kept", ro.claims("kept", cl.kept, claimed)) %}<i class="kept"></i>{{ cl.kept }} claims kept{% endcall %}{% call hot("rings", "removed", ro.claims("removed", cl.removed, claimed)) %}<i class="sell"></i>{{ cl.removed }} removed{% endcall %}{% if r.direction_split %}<span class="sub">{% for k, v in r.direction_split.items() %}{{ v }} {{ k }}{% if not loop.last %}, {% endif %}{% endfor %}</span>{% endif %}</div>
{%- else %}
<div class="half">{{ gap("Claim counts") }}</div>
{%- endif %}
</div>
</section>
{#- 10. Analyst ratings from analystdb (design item 20), asked for as the report opened, as of
    its price date: the street's view, never part of the rating, score or range. It is laid out
    like the peer ratings ring above it, with the targets beside the ring and the analysts' low
    to high target bar under, marking Tearsheet's base value and the price. Every part opens the
    side panel's Analyst ratings view. When analystdb can't answer, the panel is one quiet line;
    without `analysts` there is no panel at all. #}
{%- if analysts %}
{%- set a = analysts %}
<section class="p glass span2" id="analysts">
{%- if a.state == "ok" %}
<h4><span>Analyst ratings</span><em>analystdb, as of {{ a.asof_text }}{% if a.rebuilt %}, rebuilt from history{% endif %}</em></h4>
{%- if a.stale %}
<div class="note">Some of this may be out of date: {% if a.stale|length > 1 %}{{ a.stale[:-1]|join(", ") }} and {{ a.stale[-1] }}{% else %}{{ a.stale[0] }}{% endif %} missed analystdb’s last evening run.</div>
{%- endif %}
{%- set sd = a.sides %}
{%- set slices = [("buy", "Buy", sd.buy), ("hold", "Hold", sd.hold), ("sell", "Sell", sd.sell)] %}
<div class="donutrow">
<div class="donut">
{%- for key, call, count in slices if count > 0 %}<span class="ro ro-{{ key }}" aria-hidden="true">{{ ro.analyst_side(call, count, a.n_firms, a.asof_text) }}</span>{% endfor -%}
<div class="dn">{{ donut(80, 10, [[sd.buy, "buy"], [sd.hold, "hold"], [sd.sell, "sell"]], "Analyst ratings: " ~ sd.buy ~ " Buy, " ~ sd.hold ~ " Hold, " ~ sd.sell ~ " Sell", view="analysts") }}<b>{{ a.n_firms }}</b></div>
</div>
<div class="legend">
{%- for key, call, count in slices %}{% call hot("analysts", key, ro.analyst_side(call, count, a.n_firms, a.asof_text)) %}<i class="{{ key }}"></i>{{ count }} {{ call }}{% endcall %}{% endfor -%}
</div>
<div class="half akvs">
{%- for key, label in (("mean", "Average target"), ("median", "Median"), ("high", "High"), ("low", "Low")) %}
{%- set v = a.target[key] %}
{% call hot("analysts", "firms", ro.analyst_target(key, v, a.target.n), "kv") %}<span>{{ label }}</span>{% if v is number %}<b>{{ fmt("price", v) }}</b>{% else %}<b class="clear">not available</b>{% endif %}{% endcall %}
{%- endfor %}
</div>
</div>
{%- set t = a.target %}
{%- if t.low is number and t.high is number %}
{%- set base = n.range.base if n.range and n.range.base is number else none %}
{%- set px = today if today is number else none %}
{%- set marks = [t.low, t.high] + ([base] if base is not none else []) + ([px] if px is not none else []) %}
{%- set lo0, hi0 = marks|min, marks|max %}
{%- set pad = [(hi0 - lo0) * 0.06, 0.01]|max %}
{%- set lo, span = lo0 - pad, hi0 - lo0 + 2 * pad %}
{%- macro apos(v) -%}{{ "%.1f"|format((v - lo) / span * 100) }}%{%- endmacro -%}
{% call hot("analysts", "firms", ro.analyst_band(t.low, t.high, t.mean, t.median, base, px, n.price.date if n.price else none), "astriphot") %}<div class="astrip" aria-hidden="true"><i class="aband" style="left:{{ apos(t.low) }};width:{{ "%.1f"|format((t.high - t.low) / span * 100) }}%"></i>{% if t.mean is number %}<i class="aavg" style="left:{{ apos(t.mean) }}"></i>{% endif %}{% if t.median is number %}<i class="amed" style="left:{{ apos(t.median) }}"></i>{% endif %}{% if base is not none %}<i class="abase" style="left:{{ apos(base) }}"></i>{% endif %}{% if px is not none %}<i class="apx" style="left:{{ apos(px) }}"></i>{% endif %}</div>
<div class="aends"><span>{{ dollars(t.low) }}</span><span>{{ dollars(t.high) }}</span></div>
<div class="akeys"><span><i class="k-band"></i>analysts, low to high</span>{% if t.mean is number %}<span><i class="k-avg"></i>average</span>{% endif %}{% if t.median is number %}<span><i class="k-med"></i>median</span>{% endif %}{% if base is not none %}<span><i class="k-base"></i>Tearsheet base {{ dollars(base) }}</span>{% endif %}{% if px is not none %}<span><i class="k-px"></i>price {{ dollars(px) }}</span>{% endif %}</div>{% endcall %}
{%- endif %}
<p class="afoot">Source: analystdb, {{ a.n_firms }} firms, as of {{ a.asof_text }}. Research data, not investment advice.</p>
{%- else %}
<p class="aquiet">{{ a.note }}</p>
{%- endif %}
</section>
{%- endif %}
</aside>
{%- endmacro -%}
