<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta http-equiv="Content-Security-Policy" content="{{ csp | safe }}">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ r.company }} ({{ r.ticker }}): Tearsheet report</title>
{#- Look C: dark glass over a faint coloured light, Avenir Next, tabular figures. Everything is in
    this one style block; the page loads nothing. Interactivity is CSS only: :target and :has()
    switch the views, and <details> folds out each quoted source. #}
<style>
:root {
  color-scheme: dark;
  /* Every colour, weight, corner and the panels' blur go through these names. The defaults are
     Tearsheet's dark look at full glow, which a report file keeps; in the app, the window adds a
     second block after this one with the look picked on Settings → Appearance
     (app/src/renderer/appearance/report.ts). */
  --base: #070B14; --ink: 255 255 255; --shade: 0 0 0; --shade-k: 1;
  --panel-a: .045; --line-a: .085;
  --panel: rgb(var(--ink) / var(--panel-a)); --line: rgb(var(--ink) / var(--line-a)); --track: rgb(var(--ink) / .08);
  --band: rgb(var(--accent-rgb) / .18); --chipline: rgb(var(--accent-rgb) / .30);
  --text: #EAF1F7; --muted: #92A4B6; --accent: #7FE3F7; --accent2: #8FA2FF; --accent-lo: #4C8DFF;
  --hold: #FFC56B; --up: #63DFA5; --down: #FF7F8A; --readout: #0E1422;
  --base-rgb: 7 11 20; --text-rgb: 234 241 247; --accent-rgb: 127 227 247; --accent2-rgb: 143 162 255;
  --up-rgb: 99 223 165; --hold-rgb: 255 197 107; --down-rgb: 255 127 138;
  --g1: 32 120 150; --g2: 70 60 170; --g3: 20 90 120; --glow: 1;
  --wt: 0; --round: 1; --frost: 1;
  --ui: "Avenir Next", "Helvetica Neue", sans-serif; --num: "Avenir Next", "Helvetica Neue", sans-serif;
  --mono: "SF Mono", ui-monospace, Menlo, monospace; --r: calc(14px * var(--round));
}
* { box-sizing: border-box; }
html {
  background: radial-gradient(620px 440px at 20% 0%, rgb(var(--g1) / calc(.20 * var(--glow))), transparent 70%),
    radial-gradient(720px 520px at 92% 30%, rgb(var(--g2) / calc(.18 * var(--glow))), transparent 70%),
    radial-gradient(520px 420px at 55% 112%, rgb(var(--g3) / calc(.16 * var(--glow))), transparent 70%), var(--base);
  background-attachment: fixed;
}
body { margin: 0; color: var(--text); font: 13px/1.45 var(--ui); font-weight: calc(400 + var(--wt)); font-variant-numeric: tabular-nums; }
a { color: var(--accent); text-decoration: none; }
a:hover { text-decoration: underline; }
a:focus-visible, summary:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; border-radius: calc(6px * var(--round)); }

/* Readouts. Each chart, bar, ring, tile and row is a hot element (report/_hot.html.j2): in the
   app a link that opens it bigger, in a file an element that takes keyboard focus. Its readout
   (.ro) shows while it is pointed at or has keyboard focus. :focus-visible, not :focus, so the
   focus a click leaves never keeps a readout up once the pointer goes. A readout is shown and
   hidden by display alone, never by visibility: a child made visible that way is drawn even
   inside the column the one-column layout hides. Nothing here has a transition: a readout
   appears and goes at once. These come before the panels' own rules, so a hot bar or
   red-flag row keeps its own display. */
.hot { color: inherit; text-decoration: none; display: block; }
.hot:hover { text-decoration: none; background: var(--panel); }
.ro { display: none; position: absolute; pointer-events: none; padding: 6px 9px; border-radius: calc(9px * var(--round)); background: var(--readout); border: 1px solid var(--line); color: var(--text); font: 12px/1.4 var(--ui); font-weight: calc(400 + var(--wt)); z-index: 5; }
.hot:hover > .ro, .hot:focus-visible > .ro, .hit:hover > .ro, tr:hover > td > .hot > .ro, tr:has(:focus-visible) .ro { display: block; }
/* Over a chart, the week, case or method pointed at has its own readout, which stands in for
   the chart's. */
.hot:has(.hit:hover) > .ro, .hot:has(~ .hits .hit:hover) > .ro { display: none; }
.defs { position: absolute; width: 0; height: 0; }
.glass { background: var(--panel); border: 1px solid var(--line); border-radius: var(--r); backdrop-filter: blur(calc(18px * var(--frost))); -webkit-backdrop-filter: blur(calc(18px * var(--frost))); box-shadow: inset 0 1px 0 rgb(var(--ink) / .05); }

/* Layout. In the app both columns fill the frame and scroll on their own; a file is a page. */
.layout { display: flex; height: 100vh; }
.nums { width: 548px; flex: none; overflow: auto; padding: 12px; display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 10px; align-content: start; border-right: 1px solid var(--line); }
.col-numbers .nums { width: auto; flex: 1; min-width: 0; max-width: 640px; grid-template-columns: 1fr 1fr; border-right: 0; }
.textcol { flex: 1; min-width: 0; display: flex; flex-direction: column; }
/* The app's layout that follows the frame (column "auto"): both columns from {{ two_min }} px, and
   below that the one column the side names. The other is put away at its own size, out of
   sight, so it keeps its scroll for when the frame widens again. The key tiles above the text
   show only in one column as wide as a narrow window ({{ keys_min }}-{{ two_min - 1 }} px): with
   both columns the numbers are beside the text, and in a frame beside the app's chart the Key
   numbers sit under the chart. The page decides this by its own width alone, so the app never
   loads it again for a narrower window. */
{%- macro one_column(at) %}
  {{ at }}.side-text .nums, {{ at }}.side-numbers .textcol { position: absolute; top: 0; left: -300vw; height: 100vh; visibility: hidden; }
  {{ at }}.side-numbers .textcol { width: 100vw; }
  {{ at }}.side-numbers .nums { width: auto; flex: 1; min-width: 0; max-width: 640px; grid-template-columns: 1fr 1fr; border-right: 0; }
{%- endmacro %}
@media (max-width: {{ two_min - 1 }}px) {
{{- one_column(".col-auto") }}
}
.col-auto .keys { display: none; }
@media (min-width: {{ keys_min }}px) and (max-width: {{ two_min - 1 }}px) { .col-auto .keys { display: grid; } }
.tscroll { flex: 1; min-height: 0; overflow: auto; }
.mode-file .layout { display: block; height: auto; max-width: 1140px; margin: 0 auto; padding-bottom: 40px; }
.mode-file .nums { width: auto; overflow: visible; border-right: 0; grid-auto-flow: dense; }
.mode-file .textcol { max-width: 860px; margin: 0 auto; }
.mode-file .tscroll { overflow: visible; }
.mode-file .tbar { position: sticky; top: 0; z-index: 2; background: rgb(var(--base-rgb) / .86); backdrop-filter: blur(calc(18px * var(--frost))); -webkit-backdrop-filter: blur(calc(18px * var(--frost))); }
.rsec { scroll-margin-top: 18px; }
.mode-file .rsec, .mode-file .view { scroll-margin-top: 96px; }
.rhead { max-width: 1140px; margin: 0 auto; padding: 26px 16px 4px; }
.rhead h1 { margin: 0 0 4px; font: 26px/1.2 var(--ui); font-weight: calc(600 + var(--wt)); }
.rhead p, .foot { margin: 0 0 4px; color: var(--muted); font-size: 12.5px; }
.foot { margin: 0 14px 28px; padding: 0 22px; }
/* The downloads at the end of the report (export/): made from this saved report when clicked. */
.dl { display: flex; flex-wrap: wrap; gap: 8px; margin: 4px 14px 14px; padding: 0 22px; }
.dlb { font: 12.5px var(--ui); font-weight: calc(500 + var(--wt)); color: var(--accent); background: var(--panel); border: 1px solid var(--chipline); border-radius: calc(8px * var(--round)); padding: 6px 13px; transition: background .2s; }
.dlb:hover { background: rgb(var(--accent-rgb) / .16); text-decoration: none; }

/* Numbers column */
.span2 { grid-column: span 2; }
@media (max-width: 560px) { .span2 { grid-column: 1 / -1; } .col-numbers .nums, .col-auto.side-numbers .nums { grid-template-columns: minmax(0, 1fr); } }
/* A readout in a numbers panel shows by the item pointed at, not at the panel's heading: the
   column scrolls, and a tall panel's heading is often out of view while its bars and tiles are
   in it. A tile, figure, ring or legend entry is far narrower than its panel, and a readout
   held by it would wrap to many lines, so the panel holds the readout (nothing between them is
   positioned) and keeps it panel-wide. With no top or bottom, the readout stays where it starts
   in the item, its top edge (report/_hot.html.j2 makes it the first child), and is lifted by
   its own height to sit just above. One marked below is the last child, at the item's bottom
   edge, and stays there. A tile's padding is stepped over. */
.p { position: relative; padding: 12px 14px; min-width: 0; }
.p .ro { left: 10px; right: 10px; transform: translateY(-100%); margin-top: -3px; }
.p .ro.below { transform: none; margin-top: 3px; }
.p .tile > .ro { margin-top: -12px; }
.p .tile > .ro.below { margin-top: 12px; }
/* A bar or red-flag row is as wide as its panel, so it holds its own readout: just above it, or
   below the first one under the heading, where above would leave the panel. */
.p > .hot { position: relative; }
.p > .hot > .ro { left: -4px; right: -4px; bottom: calc(100% + 3px); transform: none; margin: 0; }
.p > h4 + .hot > .ro { top: calc(100% + 3px); bottom: auto; }
/* A readout may reach past its panel's edge, where the next panel's glass would blur it and draw
   over it, so the panel pointed at or focused is drawn over the others. */
.p:hover, .p:focus-within { z-index: 1; }
.p h4 { margin: 0 0 8px; display: flex; justify-content: space-between; gap: 8px; font: 12px var(--ui); font-weight: calc(500 + var(--wt)); color: var(--muted); }
.p h4 em { font-style: normal; text-align: right; }
.gap { margin: 4px 0 2px; color: var(--muted); font-size: 12.5px; }
.tkr { font: 19px var(--ui); font-weight: calc(600 + var(--wt)); letter-spacing: .5px; }
.tkr small { display: block; font: 12.5px var(--ui); font-weight: calc(400 + var(--wt)); color: var(--muted); letter-spacing: 0; margin-top: 1px; }
.callrow { display: flex; align-items: center; gap: 14px; margin: 10px 0 8px; }
.callrow > div > span { color: var(--muted); font-size: 12px; line-height: 1.35; }
.callrow > .hot, .callrow > .hot:focus-visible { flex: none; border-radius: 50%; }
.ring { position: relative; width: 84px; height: 84px; flex: none; }
.ring > div { position: absolute; inset: 0; display: grid; place-content: center; text-align: center; }
.ring b { font: 22px/1.1 var(--num); font-weight: calc(600 + var(--wt)); }
.ring span { font-size: 10.5px; color: var(--muted); }
.ring-svg { display: block; }
.call { font: 36px/1 var(--ui); font-weight: calc(600 + var(--wt)); letter-spacing: .5px; margin-bottom: 2px; }
.buy { color: var(--up); } .hold { color: var(--hold); } .sell { color: var(--down); }
.note { font-size: 12.5px; color: var(--hold); line-height: 1.4; background: rgb(var(--hold-rgb) / .07); border: 1px solid rgb(var(--hold-rgb) / .2); border-radius: calc(10px * var(--round)); padding: 6px 9px; }
.kvs { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px 14px; margin: 10px 0 0; }
.kvs dl { margin: 0; }
.kvs dt { color: var(--muted); font-size: 12px; line-height: 1.3; }
.kvs dd { margin: 2px 0 0; font: 15px var(--num); font-weight: calc(600 + var(--wt)); }
.kvs dd.miss, .kvs dd.words { font: 12px/1.3 var(--ui); font-weight: calc(400 + var(--wt)); color: var(--muted); }
.kvs dd.words { color: var(--text); }
.chart { display: block; width: 100%; height: auto; overflow: visible; }
/* A chart is a readout box: its readouts show on its top edge. Pointer targets laid over it
   (.hits) have a readout each: a column per week over the price line and a cell per case over
   the range's labels, or a row per method. A week's column and a case's cell aren't
   positioned, so their readouts sit against .hits, which covers the chart. A method's row is
   as wide as the chart, so it holds its own readout, which shows just above the row pointed
   at; the first row's top is the chart's. */
.cw { position: relative; }
.cw .ro { left: 0; right: 0; bottom: 100%; transform: none; margin: 0; }
.hits.col > .hit { position: relative; }
.hits { position: absolute; inset: 0; display: flex; }
.hits.col { flex-direction: column; }
.wk { flex: none; display: flex; }
.wk > .hit { flex: 1; }
.tgts { flex: none; margin-left: auto; display: flex; flex-direction: column; }
.bar { display: grid; grid-template-columns: 116px 1fr 28px 38px; align-items: center; gap: 8px; height: 23px; font-size: 12.5px; }
.bar.fbar { grid-template-columns: 130px 1fr 28px 40px; }
.bar.rbar { grid-template-columns: 74px 1fr 50px; }
.bar > span:not(.ro) { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.bar .tr { height: 7px; background: var(--track); position: relative; border-radius: calc(4px * var(--round)); }
.bar .tr i { position: absolute; top: 0; bottom: 0; left: 0; border-radius: calc(4px * var(--round)); background: linear-gradient(90deg, var(--accent-lo), var(--accent)); transform-origin: left; }
.bar .tr i.neg { background: var(--down); } .bar .tr i.self { background: var(--hold); }
.bar .tr .mid { position: absolute; left: 50%; top: -3px; bottom: -3px; width: 1px; background: rgb(var(--ink) / .26); }
.bar .tr .zero { position: absolute; top: -3px; bottom: -3px; width: 1px; background: rgb(var(--ink) / .32); }
.bar b { font: 13px var(--num); font-weight: calc(600 + var(--wt)); text-align: right; }
.bar small { color: var(--muted); font-size: 12px; text-align: right; }
.kv { display: flex; justify-content: space-between; gap: 10px; padding: 4px 0; border-top: 1px solid var(--line); color: var(--muted); font-size: 12.5px; }
.kv b { font: 12.5px var(--num); font-weight: calc(600 + var(--wt)); text-align: right; }
.kv b.clear { color: var(--muted); font-weight: calc(500 + var(--wt)); } .kv b.found { color: var(--hold); }
.tiles { display: grid; grid-template-columns: repeat(auto-fill, minmax(108px, 1fr)); gap: 8px; }
.tile { padding: 9px 10px; border-radius: calc(12px * var(--round)); background: rgb(var(--ink) / .035); border: 1px solid var(--line); min-width: 0; }
.hot.tile:focus-visible { border-radius: calc(12px * var(--round)); }
.tile span:not(.ro) { display: block; color: var(--muted); font-size: 11.5px; line-height: 1.25; min-height: 29px; }
.tile b { font: 18px var(--num); font-weight: calc(600 + var(--wt)); display: block; margin: 1px 0; }
.tile small { color: var(--muted); font-size: 11.5px; }
.tile .rk { height: 4px; background: var(--track); border-radius: calc(2px * var(--round)); position: relative; margin-top: 6px; }
.tile .rk i { position: absolute; top: -2px; width: 8px; height: 8px; border-radius: 50%; background: var(--accent); margin-left: -4px; }
.tile .rk::after { content: ""; position: absolute; left: 50%; top: -2px; bottom: -2px; width: 1px; background: rgb(var(--ink) / .28); }
.flags { display: flex; gap: 4px; height: 8px; margin: 6px 0 8px; }
.flags i { flex: 1; border-radius: calc(4px * var(--round)); background: var(--track); transform-origin: left; }
.flags i.on { background: linear-gradient(90deg, rgb(var(--hold-rgb) / .45), var(--hold)); }
.macro { display: grid; grid-template-columns: repeat(auto-fit, minmax(80px, 1fr)); gap: 6px; }
.macro div { text-align: center; }
.macro b { display: block; font: 15px var(--num); font-weight: calc(600 + var(--wt)); }
.macro span:not(.ro) { font-size: 11px; color: var(--muted); line-height: 1.25; display: block; }
.macro small { font-size: 10.5px; color: var(--muted); opacity: .8; }
.donutrow { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
/* A ring's slices show their readouts just above the ring, as the legend's show just above
   their lines; the count in the middle sits in its own box (.dn). The legend is the keyboard's
   way in. The count's box covers the whole ring, so it lets the pointer through to the slices
   under it. */
.dn { position: relative; }
.dn b { position: absolute; inset: 0; display: grid; place-content: center; font: 15px var(--num); font-weight: calc(600 + var(--wt)); pointer-events: none; }
.donut:has(.dn-buy:hover) > .ro-buy, .donut:has(.dn-hold:hover) > .ro-hold, .donut:has(.dn-sell:hover) > .ro-sell,
.donut:has(.dn-kept:hover) > .ro-kept, .donut:has(.dn-removed:hover) > .ro-removed { display: block; }
.legend { display: flex; flex-direction: column; gap: 3px; font-size: 12px; color: var(--muted); margin-right: 8px; }
.legend i { display: inline-block; width: 8px; height: 8px; border-radius: 50%; margin-right: 5px; }
.legend i.buy { background: var(--up); } .legend i.hold { background: var(--hold); } .legend i.sell { background: var(--down); } .legend i.kept { background: var(--accent); }
.legend .sub { padding-left: 13px; font-size: 11.5px; }
.half { flex: 1; min-width: 160px; }
/* The Analyst ratings panel (analystdb): the peer ratings ring's layout, the targets beside the
   ring, and under them the analysts' low-to-high target bar with the average and median, and
   Tearsheet's base value and the price marked. */
.akvs { min-width: 170px; }
.akvs > .kv:first-child { border-top: 0; }
.astriphot { margin-top: 10px; border-radius: calc(8px * var(--round)); padding: 4px 2px; }
.astrip { position: relative; height: 18px; }
.astrip i { position: absolute; }
.aband { top: 6px; height: 6px; border-radius: calc(3px * var(--round)); background: var(--band); }
.aavg, .amed { top: 2px; width: 2px; height: 14px; margin-left: -1px; }
.aavg { background: var(--accent); } .amed { background: var(--text); opacity: .7; }
.abase { top: 4px; width: 10px; height: 10px; margin-left: -5px; transform: rotate(45deg); border: 2px solid var(--accent2); background: var(--base); }
.apx { top: 0; width: 2px; height: 18px; margin-left: -1px; background: var(--hold); }
.aends { display: flex; justify-content: space-between; font: 11px var(--num); font-weight: calc(400 + var(--wt)); color: var(--muted); }
.akeys { display: flex; flex-wrap: wrap; gap: 4px 12px; margin-top: 4px; font-size: 11.5px; color: var(--muted); }
.akeys i { display: inline-block; vertical-align: middle; margin-right: 5px; }
.akeys .k-band { width: 14px; height: 6px; border-radius: calc(3px * var(--round)); background: var(--band); }
.akeys .k-avg, .akeys .k-med, .akeys .k-px { width: 2px; height: 11px; }
.akeys .k-avg { background: var(--accent); } .akeys .k-med { background: var(--text); opacity: .7; } .akeys .k-px { background: var(--hold); }
.akeys .k-base { width: 8px; height: 8px; transform: rotate(45deg); border: 2px solid var(--accent2); }
.afoot { margin: 8px 0 0; font-size: 11.5px; color: var(--muted); }
.aquiet { margin: 0; font-size: 12.5px; color: var(--muted); }
.ch-band { fill: var(--band); opacity: .6; } .ch-axis { stroke: var(--line); } .ch-grid { stroke: rgb(var(--ink) / .06); }
.ch-lab { fill: var(--muted); font: 11px var(--ui); font-weight: calc(400 + var(--wt)); } .ch-val { fill: var(--text); font: 11.5px var(--num); font-weight: calc(600 + var(--wt)); }
.ch-plab { fill: var(--hold); font: 11.5px var(--num); font-weight: calc(600 + var(--wt)); } .ch-dot { fill: var(--accent); } .ch-row { fill: var(--muted); font: 12px var(--ui); font-weight: calc(400 + var(--wt)); }
.ch-pline { stroke: var(--hold); stroke-dasharray: 3 3; } .ch-today { fill: var(--hold); }
.ch-line { fill: none; stroke: var(--accent); stroke-width: 2; stroke-linejoin: round; }
.ch-area { fill: url(#area-g); } .ch-fan { fill: url(#fan-g); }
/* The 12-month range: bull green, bear red, base dotted, with the names in the same colours. */
.ch-bull { stroke: var(--up); stroke-width: 2; } .ch-bear { stroke: var(--down); stroke-width: 2; }
.ch-base { stroke: var(--accent2); stroke-dasharray: 4 4; stroke-width: 1.8; fill: none; }
.ch-bulln { fill: var(--up); } .ch-basen { fill: var(--accent2); } .ch-bearn { fill: var(--down); }
.g-track { stroke: var(--track); fill: none; } .g-fill { stroke: url(#ring-g); fill: none; stroke-linecap: round; }
.dn-seg { fill: none; } .dn-buy { stroke: var(--up); } .dn-hold { stroke: var(--hold); } .dn-sell, .dn-removed { stroke: var(--down); } .dn-kept { stroke: var(--accent); }

/* One column: five key-number tiles above the text. They wrap onto a second row rather than cut
   their labels and figures short when the frame is narrow. */
.keys { position: relative; flex: none; display: grid; grid-template-columns: repeat(auto-fit, minmax(128px, 1fr)); gap: 8px; padding: 12px 14px; border-bottom: 1px solid var(--line); }
/* The key strip is a readout box: a tile's readout shows just below the strip. */
.keys .ro { top: 100%; left: 14px; right: 14px; }
.keys .hot, .keys .hot:focus-visible { border-radius: calc(12px * var(--round)); }
/* A hot tile's link is the grid item, so it narrows with the frame as the tile does. */
.keys > .hot { min-width: 0; }
.kt { padding: 8px 11px; border-radius: calc(12px * var(--round)); background: var(--panel); border: 1px solid var(--line); min-width: 0; }
.kt span { display: block; color: var(--muted); font-size: 11.5px; line-height: 1.3; overflow-wrap: anywhere; }
.kt b { font: 16px var(--num); font-weight: calc(600 + var(--wt)); white-space: nowrap; }
.kt b.miss { font: 12px/1.95 var(--ui); font-weight: calc(400 + var(--wt)); color: var(--muted); }
.kt b.up { color: var(--up); } .kt b.down { color: var(--down); }
.mini { height: 12px; position: relative; margin-top: 5px; }
.mini i { position: absolute; }
.mini .b { top: 4px; height: 4px; background: var(--band); border-radius: calc(2px * var(--round)); }
.mini .m { top: 2px; width: 2px; height: 8px; margin-left: -1px; background: var(--accent); }
.mini .pm { top: 0; width: 2px; height: 12px; margin-left: -1px; background: var(--hold); }

/* Text column */
.tbar { flex: none; display: flex; flex-direction: column; gap: 8px; padding: 10px 20px; border-bottom: 1px solid var(--line); background: rgb(var(--base-rgb) / .5); }
.segc { display: inline-flex; align-self: flex-start; padding: 2px; border-radius: calc(9px * var(--round)); background: rgb(var(--ink) / .06); border: 1px solid var(--line); }
.seg { padding: 4px 14px; border-radius: calc(7px * var(--round)); color: var(--muted); font-size: 12.5px; transition: background .2s, color .2s; }
.seg:hover { text-decoration: none; color: var(--text); }
.seg kbd { font: 10.5px var(--ui); font-weight: calc(400 + var(--wt)); color: var(--muted); margin-left: 6px; }
.pills { display: none; gap: 5px; flex-wrap: wrap; }
.pills a { font-size: 12px; color: var(--muted); padding: 3px 10px; border: 1px solid var(--line); border-radius: 999px; }
.pills a:hover { text-decoration: none; color: var(--text); border-color: var(--chipline); }
.pills a b { font: 11px var(--num); font-weight: calc(600 + var(--wt)); margin-left: 4px; color: var(--muted); }
.view { display: none; }

/* Which view shows: the one data-view names, unless a same-page link (render._anchor) has
   targeted the other one, or a part of the Full report. */
body[data-view="summary"]:not(:has(#full:target, #full :target)) #summary,
body:has(#summary:target) #summary,
body[data-view="full"]:not(:has(#summary:target)) #full,
body:has(#full:target, #full :target) #full { display: block; }
body[data-view="full"]:not(:has(#summary:target)) .pills,
body:has(#full:target, #full :target) .pills { display: flex; }
body[data-view="summary"]:not(:has(#full:target, #full :target)) .to-summary,
body:has(#summary:target) .to-summary,
body[data-view="full"]:not(:has(#summary:target)) .to-full,
body:has(#full:target, #full :target) .to-full { background: rgb(var(--ink) / .14); color: var(--text); box-shadow: 0 1px 2px rgb(var(--shade) / calc(.3 * var(--shade-k))); }

.txt { margin: 12px 14px 18px; padding: 4px 22px 26px; max-width: 860px; }
.txt h3 { font: 18px/1.3 var(--ui); font-weight: calc(600 + var(--wt)); margin: 20px 0 12px; }
.txt h4.sh { margin: 22px 0 10px; font: 12.5px var(--ui); font-weight: calc(600 + var(--wt)); color: var(--muted); }
.cl { margin: 0 0 16px; }
.cl p { margin: 0; font: 15.5px/1.62 var(--ui); font-weight: calc(400 + var(--wt)); }
.meta { display: flex; gap: 6px; align-items: center; margin-top: 6px; flex-wrap: wrap; }
details.src[open] { flex-basis: 100%; }
details.src > summary { list-style: none; display: inline-block; }
details.src > summary::-webkit-details-marker { display: none; }
.chip { font: 11.5px var(--ui); font-weight: calc(500 + var(--wt)); color: var(--accent); border: 1px solid var(--chipline); border-radius: 999px; padding: 1px 9px; cursor: pointer; transition: background .2s; }
.chip:hover, details[open] > .chip { background: rgb(var(--accent-rgb) / .16); }
.flag, .cid { margin-left: auto; font-size: 12px; color: var(--muted); }
.flag:hover { color: var(--text); text-decoration: none; }
.cid { font: 11.5px var(--mono); font-weight: calc(400 + var(--wt)); }
.read { font-size: 12px; color: var(--accent); }
.quote { margin: 8px 0 0; padding: 10px 13px; border-radius: calc(12px * var(--round)); background: rgb(var(--ink) / .045); border: 1px solid var(--line); font-size: 13.5px; line-height: 1.5; }
.quote span { display: block; color: var(--muted); font-size: 12px; margin-top: 4px; }
.cnote { margin-top: 7px; color: var(--hold); font-size: 13px; padding: 6px 10px; border-radius: calc(10px * var(--round)); background: rgb(var(--hold-rgb) / .06); }
.code { font-size: 14px; color: var(--muted); margin: 0 0 12px; line-height: 1.55; }
.code b { color: var(--text); font-weight: calc(600 + var(--wt)); }
.rf { padding: 10px 13px; border-radius: calc(12px * var(--round)); margin: 0 0 14px; font-size: 14px; background: rgb(var(--hold-rgb) / .07); border: 1px solid rgb(var(--hold-rgb) / .24); }
.rf b { color: var(--hold); }
.callline { font: 17px/1.5 var(--ui); font-weight: calc(500 + var(--wt)); margin: 6px 0 14px; }
.callline b { font-weight: calc(600 + var(--wt)); }
.kp { list-style: none; margin: 0; padding: 0; }
.kp li { padding: 12px 0; border-top: 1px solid var(--line); }
.kp li.none { color: var(--muted); font-size: 14px; }
.kp .sec { font: 12px var(--ui); font-weight: calc(600 + var(--wt)); color: var(--accent); display: block; margin-bottom: 3px; }
.heads { list-style: none; padding: 0; margin: 0 0 16px; display: grid; grid-template-columns: 1fr 1fr; gap: 8px 16px; }
.heads li { font-size: 13.5px; border-bottom: 1px solid var(--line); padding-bottom: 6px; }
.heads a { color: var(--text); }
.heads small, .removed small { display: block; color: var(--muted); font-size: 12px; margin-top: 2px; }
table.t { width: 100%; border-collapse: collapse; font-size: 13.5px; margin: 0 0 14px; }
table.t th { text-align: left; font: 12px var(--ui); font-weight: calc(500 + var(--wt)); color: var(--muted); padding: 7px 10px; border-bottom: 1px solid var(--line); }
table.t td { padding: 7px 10px; border-bottom: 1px solid var(--line); vertical-align: top; }
/* A table sits in a readout box with a strip kept free below it, where a row's readout shows,
   over a hint while no row is pointed at. A row's links fill its cells, so a click anywhere
   in the row opens the table bigger. */
.tw { position: relative; padding-bottom: 28px; }
.tw .ro { left: 0; right: 0; bottom: 0; }
.rhint { position: absolute; left: 0; bottom: 6px; margin: 0; color: var(--muted); font-size: 12px; }
table.t .hot, .cell { display: block; margin: -7px -10px; padding: 7px 10px; }
.cell, .cell:hover { color: inherit; text-decoration: none; }
table.t tr:has(.hot):hover > td { background: var(--panel); }
table.t .hot:hover { background: none; }
.removed, .filings { list-style: none; padding: 0; margin: 0 0 14px; }
.removed li, .filings li { padding: 8px 0; border-top: 1px solid var(--line); font-size: 14px; }
.filings li { font-size: 13px; color: var(--muted); }
.filings .read { margin-left: 8px; }

/* Printing shows the report as it reads, with no readouts. */
@media print { .ro, .rhint { display: none !important; } .tw { padding-bottom: 0; } }

/* Motion: panels rise in turn, bars grow, rings draw, the price line traces and the fan fades
   in. Each plays once, and none plays under the Mac's Reduce motion setting, or in a frame
   loaded after the report was already on show (motion off). */
{%- if motion %}
@media (prefers-reduced-motion: no-preference) {
  @keyframes rise { from { opacity: 0; transform: translateY(10px); } }
  @keyframes grow { from { transform: scaleX(0); } }
  @keyframes draw { from { stroke-dasharray: 0 2000; } }
  /* A ring's slice has no dash of its own to grow from, so its draw-in names both ends, along
     the slice's pathLength of 1, and fills backwards only: once drawn, the slice has no dash. */
  @keyframes draw-arc { from { stroke-dasharray: 0 1; } to { stroke-dasharray: 1 0; } }
  @keyframes trace { from { stroke-dashoffset: 1; } }
  @keyframes fade { from { opacity: 0; } }
  .nums > * { animation: rise .5s cubic-bezier(.2,.7,.2,1) both; }
  .nums > :nth-child(2) { animation-delay: .07s; } .nums > :nth-child(3) { animation-delay: .14s; }
  .nums > :nth-child(4) { animation-delay: .21s; } .nums > :nth-child(5) { animation-delay: .28s; }
  .nums > :nth-child(6) { animation-delay: .35s; } .nums > :nth-child(7) { animation-delay: .42s; }
  .nums > :nth-child(8) { animation-delay: .49s; } .nums > :nth-child(9) { animation-delay: .56s; }
  /* Filled backwards only: a transform kept after the rise would hold each key tile as its
     readout's containing block, squeezing the readout under the tile instead of the strip. */
  .keys > * { animation: rise .5s cubic-bezier(.2,.7,.2,1) backwards; }
  .keys > :nth-child(2) { animation-delay: .07s; } .keys > :nth-child(3) { animation-delay: .14s; }
  .keys > :nth-child(4) { animation-delay: .21s; } .keys > :nth-child(5) { animation-delay: .28s; }
  .bar .tr i, .flags i { animation: grow .9s .25s cubic-bezier(.2,.7,.2,1) both; }
  .g-fill { animation: draw 1.4s .2s cubic-bezier(.2,.7,.2,1) both; }
  .dn-seg { animation: draw-arc 1.4s .2s cubic-bezier(.2,.7,.2,1) backwards; }
  .ch-line { stroke-dasharray: 1; animation: trace 1.6s .25s cubic-bezier(.4,.1,.2,1) both; }
  .ch-area { animation: fade .8s .9s both; }
  .ch-fan, .ch-bull, .ch-base, .ch-bear { animation: fade .9s 1.5s both; }
  .ch-band { transform-box: fill-box; transform-origin: left; animation: grow 1s .3s cubic-bezier(.2,.7,.2,1) both; }
  .tile .rk i { animation: rise .5s .6s both; }
  .view .txt { animation: rise .5s .15s cubic-bezier(.2,.7,.2,1) both; }
  details[open] > .quote { animation: rise .25s ease-out both; }
}
{%- endif %}
</style>
</head>
{%- from "report/_numbers.html.j2" import numbers_column, key_strip with context %}
{%- from "report/_summary.html.j2" import summary_view with context %}
{%- from "report/_full.html.j2" import full_view with context %}
{%- set SHORT = {"rating": "Rating", "score": "Score", "valuation": "Valuation", "business": "Business", "risks": "Risks", "results": "Results", "news": "News", "trends": "Trends", "watch": "Watch"} %}
<body data-view="{{ view }}" class="mode-{{ mode }} col-{{ column }} side-{{ side }}">
<svg class="defs" width="0" height="0" aria-hidden="true" focusable="false"><defs>
<linearGradient id="ring-g" x1="0" y1="0" x2="1" y2="1"><stop offset="0" style="stop-color: var(--accent-lo)"/><stop offset="1" style="stop-color: var(--accent)"/></linearGradient>
<linearGradient id="area-g" x1="0" y1="0" x2="0" y2="1"><stop offset="0" style="stop-color: var(--accent)" stop-opacity=".18"/><stop offset="1" style="stop-color: var(--accent)" stop-opacity="0"/></linearGradient>
<linearGradient id="fan-g" x1="0" y1="0" x2="1" y2="0"><stop offset="0" style="stop-color: var(--accent2)" stop-opacity=".04"/><stop offset="1" style="stop-color: var(--accent2)" stop-opacity=".14"/></linearGradient>
</defs></svg>
{%- if mode == "file" %}
<header class="rhead">
<h1>{{ r.company }} ({{ r.ticker }})</h1>
<p>Report run {{ r.run_at }}.{% if r.mode_note %} {{ r.mode_note }}{% endif %}</p>
<p>{{ ADVICE_LINE }}</p>
</header>
{%- endif %}
<main class="layout">
{%- if column != "text" %}
{{ numbers_column() }}
{%- endif %}
{%- if column != "numbers" %}
<div id="text" class="textcol">
{%- if key_tiles %}
{{ key_strip() }}
{%- endif %}
<nav class="tbar" aria-label="Views">
<div class="segc"><a class="seg to-summary" href="{{ anchor('summary') }}">Summary{% if mode == "app" %}<kbd>⌘1</kbd>{% endif %}</a><a class="seg to-full" href="{{ anchor('full') }}">Full report{% if mode == "app" %}<kbd>⌘2</kbd>{% endif %}</a></div>
<div class="pills">
{%- for s in r.sections %}<a href="{{ anchor('s-' ~ s.key) }}">{{ SHORT.get(s.key) or s.title }}{% if s.sentences %}<b>{{ s.sentences | length }}</b>{% endif %}</a>{% endfor -%}
<a href="{{ anchor('s-checks') }}">Checks</a><a href="{{ anchor('s-methodology') }}">Method</a>
</div>
</nav>
<div class="tscroll">
{{ summary_view() }}
{{ full_view() }}
{%- if mode == "app" and report_id %}
<nav class="dl" aria-label="Download this report">
<a class="dlb" href="tearsheet://download/pdf/{{ report_id }}">Download PDF</a>
<a class="dlb" href="tearsheet://download/pptx/{{ report_id }}">Download slide deck</a>
<a class="dlb" href="tearsheet://download/xlsx/{{ report_id }}">Download Excel</a>
</nav>
{%- endif %}
{%- if mode == "app" %}
<footer class="foot">Report run {{ r.run_at }}.{% if r.mode_note %} {{ r.mode_note }}{% endif %} {{ ADVICE_LINE }}</footer>
{%- endif %}
</div>
</div>
{%- endif %}
</main>
</body>
</html>
