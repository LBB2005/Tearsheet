# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
build/
dist/
# ...except app/build, which holds the app icon and its sources.
!app/build/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# The desktop app (Phase 1c)
node_modules/
app/out/
app/dist/
# The packaged app's engine, made by scripts/build-engine.sh
app/engine-bundle/

# Local data and secrets. Keys live in the macOS Keychain, never in files.
.env
.env.*
*.key
*.pem
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.sqlite.*.bak
# Except the stored test runs CI replays (synthetic data, no keys): scripts/make_test_runs.py
!engine/tests/fixtures/runs/tearsheet.sqlite

# Claude Code's own folder: worktrees, sessions and local settings
.claude/

# macOS
.DS_Store
